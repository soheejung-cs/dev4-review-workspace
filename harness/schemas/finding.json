{ "$schema": "http://json-schema.org/draft-07/schema#", "title": "harness finding", "type": "object",
  "required": ["id", "layer", "file", "line", "claim", "why", "evidence", "severity"],
  "properties": {
    "id": {"type": "string"}, "layer": {"enum": ["설계", "코드"]},
    "file": {"type": "string"}, "line": {"type": "integer", "minimum": 1},
    "claim": {"type": "string", "description": "한 문장: 결함 → 원인"},
    "why": {"type": "string", "minLength": 40, "description": "왜 문제가 되는지 — 이대로 두면 누가/무엇이 어떻게 되나(결과·영향 범위·발견 가능성). 근거(수치·규칙·스펙 절)를 함께"},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "^([^:\\s]+|pr-body):\\d+"}, "minItems": 1},
    "rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2,5}-\\d{2}$"}},
    "severity": {"enum": ["blocking", "non-blocking", "question"]},
    "arch_edge": {"type": "string", "description": "설계 층: arch.json 의 connections[source->target] 또는 risks[kind]"},
    "status": {"enum": ["valid", "invalid", "inconclusive"], "description": "adjudicate 가 채움"},
    "obligations": {"type": "object"}, "reasons": {"type": "array", "items": {"type": "string"}}
  } }
