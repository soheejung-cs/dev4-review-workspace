diff --git a/src/storage/page_buffer.c b/src/storage/page_buffer.c
index bfa4fd864..ae4f1313f 100644
--- a/src/storage/page_buffer.c
+++ b/src/storage/page_buffer.c
@@ -7869,7 +7869,7 @@ pgbuf_timed_sleep_error_handling (THREAD_ENTRY * thrd_entry, PGBUF_BCB * bufptr)
   if (bufptr->next_wait_thrd == NULL)
     {
       /* The thread entry has been already removed from the BCB waiting queue by another thread. */
-      return NO_ERROR;
+      goto end;
     }
 
   /* case 2 : first waiting thread != thrd_entry */
@@ -7886,7 +7886,7 @@ pgbuf_timed_sleep_error_handling (THREAD_ENTRY * thrd_entry, PGBUF_BCB * bufptr)
 	    }
 	  prev_thrd_entry = prev_thrd_entry->next_wait_thrd;
 	}
-      return NO_ERROR;
+      goto end;
     }
 
   /* case 3 : first waiting thread == thrd_entry */
@@ -7935,6 +7935,16 @@ pgbuf_timed_sleep_error_handling (THREAD_ENTRY * thrd_entry, PGBUF_BCB * bufptr)
 	}
     }
 
+end:
+  /* The thread that gave up is off the queue. When no blocked reader or writer is left, clear waiter_exists as
+   * pgbuf_wakeup_reader_writer () does: a stale bit makes pgbuf_latch_bcb_upon_fix () block every later READ
+   * request on a READ-latched page, and keeps the lock-free READ path off, until a holder unlatches. The caller
+   * holds the BCB mutex, under which every waiter_exists transition is made. */
+  if (!pgbuf_is_exist_blocked_reader_writer (bufptr))
+    {
+      set_waiter_exists (&bufptr->atomic_latch, false);
+    }
+
   return NO_ERROR;
 }
 
