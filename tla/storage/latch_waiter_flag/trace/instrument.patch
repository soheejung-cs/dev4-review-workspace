+#if defined (TLA_TRACE) && defined (SERVER_MODE)
+/* the model's view of the BCB: mode, fcnt, waiter_exists, the wait queue as thread indexes (front first) */
+static const char *
+tla_bcb_state_ (PGBUF_BCB * bcb, char *buf, size_t len)
+{
+  PGBUF_ATOMIC_LATCH_IMPL impl = get_impl (&bcb->atomic_latch);
+  const char *m = impl.impl.latch_mode == PGBUF_LATCH_READ ? "R" : impl.impl.latch_mode == PGBUF_LATCH_WRITE ? "W"
+    : impl.impl.latch_mode == PGBUF_NO_LATCH ? "N" : "X";
+  int n = snprintf (buf, len, "\"mode\":\"%s\",\"fcnt\":%d,\"wex\":%s,\"q\":[", m, (int) impl.impl.fcnt,
+		    impl.impl.waiter_exists ? "true" : "false");
+  THREAD_ENTRY *t;
+  for (t = bcb->next_wait_thrd; t != NULL && n < (int) len - 16; t = t->next_wait_thrd)
+    {
+      n += snprintf (buf + n, len - n, "%s%d", t == bcb->next_wait_thrd ? "" : ",", TLA_WHO (t));
+    }
+  snprintf (buf + n, len - n, "]");
+  return buf;
+}
+#endif
